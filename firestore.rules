rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /config/app { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }

    // Live Streaming: sinyal sementara dan komentar. Tidak ada rekaman. Hanya user login.
    match /live/{hostId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == hostId;
      match /viewers/{vid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && (request.auth.uid == vid || request.auth.uid == hostId);
        match /{sub}/{cid} {
          allow read, write: if request.auth != null && (request.auth.uid == vid || request.auth.uid == hostId);
        }
      }
      match /comments/{cid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.uid == hostId);
      }
    }
  }
}
