{
  "name": "netcheck",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/advisor.test.mjs tests/mql-lint.test.mjs",
    "build": "vite build",
    "build:admin": "vite build --mode admin",
    "deploy:admin": "vite build --mode admin && firebase deploy --only hosting",
    "sync": "vite build && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "firebase": "^10.14.0",
    "jszip": "^3.10.1",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "lightweight-charts": "~4.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "vite": "^5.4.0"
  }
}
